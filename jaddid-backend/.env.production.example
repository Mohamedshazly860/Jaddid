# Django production settings
SECRET_KEY=replace-with-a-generated-django-secret-key
DEBUG=False
ALLOWED_HOSTS=your-railway-domain.up.railway.app

# Railway PostgreSQL provides this automatically when the database is linked.
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database

# Use these only when DATABASE_URL is unavailable.
# DB_NAME=replace-database
# DB_USER=replace-user
# DB_PASSWORD=replace-password
# DB_HOST=replace-host
# DB_PORT=5432

# Frontend security origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# Redis service URL (Railway can provide this when Redis is linked)
REDIS_URL=redis://replace-user:replace-password@replace-host:6379

# AI assistant
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
COHERE_API_KEY=replace-with-cohere-api-key

# MongoDB Atlas vector search
MONGODB_URI=mongodb+srv://replace-user:replace-password@replace-cluster.example.mongodb.net/
MONGODB_DB_NAME=replace-database
MONGODB_COLLECTION=replace-knowledge-collection
MONGODB_VECTOR_INDEX_NAME=vector_index
MONGODB_PRODUCT_COLLECTION=product_vectors
MONGODB_VECTOR_PRODUCT_INDEX=product_vector_index
EMBEDDING_MODEL=embed-multilingual-light-v3.0
SEMANTIC_SEARCH_MIN_SCORE=0.35

# Stripe payments
STRIPE_PUBLISHABLE_KEY=pk_live_replace-with-publishable-key
STRIPE_SECRET_KEY=sk_live_replace-with-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-secret
